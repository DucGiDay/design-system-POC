# Build site-product. Trang và API cùng domain với host Vue 2; nginx của host Vue 2 proxy /_v3_host/ và /_sub_*/.
VITE_API_BASE_URL=https://posapi.ipos.vn/
VITE_API_TIMEOUT=10000
# Entry qiankun (đường dẫn cùng domain). 2 sub tách riêng chỉ khai khi môi trường đã deploy sub đó,
# giống VUE_APP_SUB_*_URL của host Vue 2; để trống thì module chạy trong sub main.
VITE_SUB_MAIN_URL=/_sub_main/
VITE_SUB_MULTICHANNEL_URL=
VITE_SUB_TABLEORDER_URL=
