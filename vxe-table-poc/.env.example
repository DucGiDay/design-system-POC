# Copy thành .env.development.local (đã gitignore) rồi điền giá trị thật.
# Lấy VITE_ACCESS_TOKEN từ .env.development của fabi-cms-sub-vue3 — không commit token.
VITE_API_BASE_URL=https://testposapi.ipos.vn/
VITE_ACCESS_TOKEN=
# ms, mặc định 10000
VITE_API_TIMEOUT=10000

# Entry 3 sub-app khi chạy local (npm run dev ở từng repo sub)
VITE_SUB_MAIN_URL=http://localhost:5173
VITE_SUB_MULTICHANNEL_URL=http://localhost:5174
VITE_SUB_TABLEORDER_URL=http://localhost:5175
# Host Vue 2 chạy local — nút "Về giao diện cũ" chuyển sang đây
VITE_LEGACY_URL=http://localhost:6969
